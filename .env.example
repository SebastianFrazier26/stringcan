# Copy to .env (gitignored). Dummy values only; never commit real keys.
DATABASE_URL=postgres://stringcan:stringcan@localhost:5432/stringcan
BIND_ADDR=127.0.0.1:8080
# Bootstrap token that may create tenants. Generate a long random value.
STRINGCAN_ADMIN_TOKEN=replace-with-a-long-random-string
# fake (default) or stripe_test. stripe_test requires Connect onboarding before payments.
STRINGCAN_PROCESSOR=fake
# Signing secret of the webhook endpoint (whsec_...). The webhook route is off without it.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Stripe TEST mode only. The code refuses anything not starting with sk_test_.
STRIPE_SECRET_KEY=sk_test_replace_me
# Plaid SANDBOX only (bank balance check for the required float). The code
# refuses any PLAID_ENV other than sandbox. Dummy values below.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=replace_me_client_id
PLAID_SECRET=replace_me_sandbox_secret
# Set to 1 to run the Postgres-backed integration tests (uses DATABASE_URL).
STRINGCAN_TEST_DB=0
# Remote databases must use sslmode=verify-full. Set to 1 only for a sibling
# container (docker compose), never for a network database.
STRINGCAN_ALLOW_INSECURE_DB=0
